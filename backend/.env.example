# Server Configuration
PORT=5000
JWT_SECRET=super-secret-doc-checklist-key-2026

# Google Drive Integration:
# 1. Target Google Drive Folder ID:
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# 2. Path to Google Service Account JSON key:
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# 3. Google Apps Script Web App Integration (for personal @gmail.com Drive storage quota):
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id/exec
