{
  "name": "checklist-backend",
  "version": "1.0.0",
  "description": "Backend API for Document Checklist with Google Drive Integration & Admin Review",
  "main": "server.js",
  "scripts": {
    "prestart": "node ../cleanup-ports.js",
    "start": "node --watch-path=server.js --watch-path=driveService.js --watch-path=dataStore.js --watch-path=db.js --watch-path=.env server.js",
    "predev": "node ../cleanup-ports.js",
    "dev": "node --watch-path=server.js --watch-path=driveService.js --watch-path=dataStore.js --watch-path=db.js --watch-path=.env server.js",
    "test:drive": "node test-drive.js",
    "connect-drive": "node setup-oauth.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.7",
    "uuid": "^11.1.0"
  }
}
